{
  "name": "computemate-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "tsc --noEmit && vite build --config ui/vite.config.ts && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "test:ui": "node --test tests/ui.test.mjs",
    "package:vscode": "npm run build && cd extensions/vscode && npx --yes @vscode/vsce@3.7.1 package --skip-license --out computemate-0.1.0.vsix"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "esbuild": "^0.25.0"
  }
}
